# 0xCultiv8 Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# REDIS (Rate Limiting & Caching)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# BLOCKCHAIN RPC
# =============================================================================
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_RPC_URL_BACKUP=https://mainnet.infura.io/v3/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL_BACKUP=https://mainnet.base.org

# =============================================================================
# AI PROVIDERS
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# =============================================================================
# AUTHENTICATION
# =============================================================================
AUTH_SECRET=your-secret-key-at-least-32-characters-long
AUTH_URL=https://your-domain.com

# =============================================================================
# x402 PAYMENT PROTOCOL
# =============================================================================
# Coinbase facilitator (fee-free USDC on Base)
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Your receiving address for USDC payments (Base network)
X402_PAYMENT_RECEIVER=0xYourUSDCReceivingAddress

# Network identifier (Base mainnet)
X402_NETWORK=eip155:8453

# Feature flag to enable/disable x402 payments
X402_ENABLED=true

# =============================================================================
# SECURITY
# =============================================================================
# Comma-separated list of admin wallet addresses
ADMIN_ADDRESSES=0xAdminAddress1,0xAdminAddress2

# Allowed origins for CORS
ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com

# =============================================================================
# KEY MANAGEMENT (Production)
# =============================================================================
# Options: 'aws_kms', 'vault', 'env' (env only for development)
KEY_MANAGER_BACKEND=vault

# AWS KMS (if using aws_kms backend)
AWS_KMS_KEY_ID=your-kms-key-id
AWS_REGION=us-east-1

# HashiCorp Vault (if using vault backend)
VAULT_ADDR=https://vault.your-domain.com
VAULT_TOKEN=your-vault-token
VAULT_SECRET_PATH=secret/data/cultiv8

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================
# Flashbots MEV Protection
FLASHBOTS_RPC_URL=https://rpc.flashbots.net

# Application URL
NEXT_PUBLIC_APP_URL=https://your-domain.com
