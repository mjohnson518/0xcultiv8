# Production Alerting Configuration
# Copy this file to .env.local and fill in the values
#
# DO NOT commit actual keys to version control!

# =============================================================================
# PagerDuty Configuration
# =============================================================================
# Create an integration key at: https://support.pagerduty.com/docs/services-and-integrations
# Select "Events API v2" integration type
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-integration-key-here

# =============================================================================
# Slack Configuration
# =============================================================================
# Create a Slack webhook at: https://api.slack.com/messaging/webhooks
# 1. Go to https://api.slack.com/apps
# 2. Create a new app or select existing
# 3. Enable "Incoming Webhooks"
# 4. Add a new webhook to your workspace
SLACK_WEBHOOK_URL=your-slack-webhook-url-here
SLACK_ALERT_CHANNEL=#cultiv8-alerts

# =============================================================================
# Discord Configuration
# =============================================================================
# Create a Discord webhook at:
# 1. Go to Server Settings > Integrations > Webhooks
# 2. Create a new webhook
# 3. Copy the webhook URL
DISCORD_WEBHOOK_URL=your-discord-webhook-url-here

# =============================================================================
# Email Configuration (SendGrid)
# =============================================================================
# Get a SendGrid API key at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here
ALERT_FROM_EMAIL=alerts@cultiv8.xyz
ALERT_TO_EMAILS=oncall@cultiv8.xyz,security@cultiv8.xyz

# =============================================================================
# Service Identification
# =============================================================================
SERVICE_NAME=cultiv8-agent
NODE_ENV=production
